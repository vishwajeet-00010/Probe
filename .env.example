# Firebase console > Project settings > Your apps > Web app.
# These values are public by design; firestore.rules is the security boundary.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# RevenueCat dashboard > Project > API keys > Web Billing public key (rcb_...).
# Leave empty to hide checkout (everyone stays on Free after the 14-day trial).
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
