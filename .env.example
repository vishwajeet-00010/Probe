# Local demo is explicit, disabled in production unless intentionally enabled.
PROBE_DEMO_ENABLED=true
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_URL=http://localhost:3000
# Firebase console > project settings > web app (public configuration, not admin credentials)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Server only: service account from Firebase console; prefer workload identity in hosting.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Stripe dashboard keys and webhook signing secret. No live calls without configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_GROUP_PRICE_ID=
# Optional integration adapters (not yet activated)
EMAIL_FROM=
EMAIL_API_KEY=
ERROR_TRACKING_DSN=
ANALYTICS_WRITE_KEY=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
