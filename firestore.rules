rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // All P0 data access goes through the authenticated server. Admin SDK bypasses
  // these rules and MUST enforce the central tenant/permission boundary.
  // Mobile clients will use the same API until narrowly scoped rules are tested.
  match /{document=**} { allow read, write: if false; }
 }
}
